CONFIG_FILE_PATH=.env
HTTP_PORT=8080
RATE_LIMIT=1000
RATE_LIMIT_CLEANUP_INTERVAL=1m
RAW_LOGS_BUFFER=10000
CONSUMER_BATCH_SIZE=50
CHANNEL_SEND_TIMEOUT=100ms
MAX_BODY_BYTES=1048576
APP_ENV=
ROUTING_CONFIG_PATH=configs/routing.json
DEFAULT_DESTINATION=service1

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=log_engine
RABBITMQ_PASS=

RABBITMQ_MGMT_URL=
RABBITMQ_USE_TLS=false
PUBLISH_TIMEOUT=5s

PIPELINE_WORKER_COUNT=4
WRITE_BATCH_SIZE=100
WRITE_FLUSH_INTERVAL=1s
DB_DIR=./data
DB_BUSY_TIMEOUT=5s
RETRY_BACKOFFS=1s,5s,10s
DEAD_LETTER_PATH=logs-failed.json
DEAD_LETTER_MAX_BYTES=10485760
