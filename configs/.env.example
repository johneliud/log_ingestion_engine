HTTP_PORT=8080
RATE_LIMIT=1000
RATE_LIMIT_CLEANUP_INTERVAL_IN_SECONDS=60
RAW_LOGS_BUFFER=10000
CONSUMER_BATCH_SIZE=50
CHANNEL_SEND_TIMEOUT_IN_MILLISECONDS=100
MAX_BODY_BYTES=1048576
APP_ENV=
ROUTING_RULES=
DEFAULT_DESTINATION=service1
TRUSTED_PROXIES=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=log_engine
RABBITMQ_PASS=

RABBITMQ_MGMT_URL=
RABBITMQ_VHOST=/
RABBITMQ_USE_TLS=false
PUBLISH_TIMEOUT_IN_SECONDS=5
RABBITMQ_RECONNECT_BACKOFFS_IN_SECONDS=1,5,10,30

PIPELINE_WORKER_COUNT=4
WRITE_BATCH_SIZE=100
WRITE_FLUSH_INTERVAL_IN_SECONDS=1
DB_DIR=./data
DB_BUSY_TIMEOUT_IN_SECONDS=5
RETRY_BACKOFFS_IN_SECONDS=1,5,10
DEAD_LETTER_PATH=logs-failed.json
DEAD_LETTER_MAX_BYTES=10485760
SPOOL_PATH=logs/ingestion-spool.log
METRICS_THROUGHPUT_WINDOW_IN_SECONDS=60

METRICS_BACKLOG_TIMEOUT_IN_SECONDS=2
SHUTDOWN_GRACE_PERIOD_IN_SECONDS=30

# Allowed CORS origins for server-sent events.
CORS_ALLOWED_ORIGINS=
